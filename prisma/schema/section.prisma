model Section {
    id       String @id @default(uuid())
    name     String
    capacity Int

    courseId     String
    semesterId   String
    instructorId String

    course Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    isDeleted Boolean   @default(false)
    deletedAt DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    registrations Registration[]
    exams         Exam[]

    @@unique([courseId, semesterId, name])
    @@index([instructorId, semesterId])
    @@map("sections")
}
