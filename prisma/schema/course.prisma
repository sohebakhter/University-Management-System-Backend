model Course {
    id     String @id @default(uuid())
    title  String
    code   String @unique
    credit Int

    departmentId String
    department   Department @relation(fields: [departmentId], references: [id])

    sections Section[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@index([departmentId])
    @@map("courses")
}
