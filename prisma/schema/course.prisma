model Course {
    id     String @id @default(uuid())
    title  String
    code   String @unique
    credit Int

    departmentId String
    department   Department @relation(fields: [departmentId], references: [id])

    isDeleted Boolean   @default(false)
    deletedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    sections Section[]

    @@index([departmentId])
    @@map("courses")
}
