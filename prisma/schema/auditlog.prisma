model AuditLog {
    id       String  @id @default(uuid())
    actorId  String?
    action   String
    entity   String
    entityId String
    metadata Json?

    createdAt DateTime @default(now())

    actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

    @@index([actorId, createdAt])
    @@index([entity, entityId])
    @@map("auditlogs")
}
